{
  "name": "cadence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "mcp": "tsx server/mcp-main.ts",
    "demo": "vite --mode demo --port 5191",
    "start": "tsx server/main.ts",
    "reset-password": "tsx server/reset-password.ts",
    "decrypt-backup": "tsx server/decrypt-backup.ts",
    "e2e": "node tests/e2e/planner.e2e.cjs && node tests/e2e/whiteboard.e2e.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "lucide-react": "1.47.0",
    "nodemailer": "10.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
