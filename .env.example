# Cadence server settings. Copy to .env (or set in your host's environment). All are optional:
# with none of the sign-in settings, people sign in with passwords as before.

# Where the server listens.
PORT=8080
HOST=127.0.0.1
# Data folder: the main workspace database. The account store and signin-log.jsonl sit beside it.
TASKS_DB=data/tasks.db
# 1 = everyone signs in (the default for pnpm start), 0 = off.
CADENCE_REQUIRE_LOGIN=1

# The address people use. Every emailed link starts with it. Needed for Google and email-link sign-in.
PUBLIC_URL=https://cadence.example.com

# Continue with Google: an OAuth client (Web application) with redirect URI {PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Accounts on this domain sign in only with Google (only while Google is configured).
STAFF_GOOGLE_DOMAIN=

# System mail (sign-in links, invites). Port 465 = implicit TLS, 587 = STARTTLS.
# Example: Google's SMTP relay, IP-authenticated, no user or password.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_FROM=Cadence <no-reply@example.com>
SMTP_USER=
SMTP_PASS=

# Encrypted cloud backups (any S3-compatible bucket: Backblaze B2, Cloudflare R2, AWS S3, Wasabi).
# Every snapshot is gzipped, encrypted with AES-256-GCM and uploaded; same keep rules as local snapshots.
# Keep the passphrase in a password manager: without it the backups cannot be opened.
CADENCE_BACKUP_S3_ENDPOINT=
CADENCE_BACKUP_S3_REGION=auto
CADENCE_BACKUP_S3_BUCKET=
CADENCE_BACKUP_S3_KEY_ID=
CADENCE_BACKUP_S3_SECRET=
CADENCE_BACKUP_S3_PREFIX=cadence
CADENCE_BACKUP_PASSPHRASE=
